VITE_SERVER_URL=http://localhost:3001

# Optional: enables real in-app YouTube search (click a result instead of
# the "Find on YouTube" popup). Free, no card - create a project at
# console.cloud.google.com, enable "YouTube Data API v3", then
# Credentials > Create Credentials > API Key. Restrict the key to that API
# and to your domain(s) (localhost + your deployed URL) once you have one.
# Without this set, the app falls back to the popup finder automatically.
VITE_YOUTUBE_API_KEY=
