# Comma-separated allowed frontend origins. Leave unset for local dev
# (defaults to allowing any origin).
# CLIENT_ORIGIN=http://localhost:5173

# Optional TURN relay for the video call (Cloudflare Realtime > TURN). Without
# these, the call only uses public STUN and can fail between two different
# networks (e.g. laptop on Wi-Fi + phone on cellular).
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Optional: persistent account storage (Turso, a free hosted SQLite - no
# card needed). Without these, accounts are stored in a local file
# (server/couchcrew.db), which is fine for local dev but gets wiped on every
# redeploy on Render's free tier (its filesystem is ephemeral - confirmed
# against Render's own docs, see LOG.md). Create a free database at
# turso.tech, then `turso db show <name> --url` and `turso db tokens create
# <name>` give you these two values.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
