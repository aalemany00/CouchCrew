# Comma-separated allowed frontend origins. Leave unset for local dev
# (defaults to allowing any origin).
# CLIENT_ORIGIN=http://localhost:5173

# Optional TURN relay for the video call (Cloudflare Realtime > TURN). Without
# these, the call only uses public STUN and can fail between two different
# networks (e.g. laptop on Wi-Fi + phone on cellular).
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
